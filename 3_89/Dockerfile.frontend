FROM node:16-alpine AS build
WORKDIR /usr/src/app
COPY package*.json ./
RUN npm install 
COPY . .
ENV REACT_APP_BACKEND_URL=http://localhost:8080
RUN npm run build
FROM scratch
WORKDIR /usr/src/app
RUN npm install -g serve && \
    adduser -D appuser
COPY --from=build /usr/src/app/build ./build    
EXPOSE 5001
USER appuser
CMD ["serve", "-s", "-l", "5001", "build"]