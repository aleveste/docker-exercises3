FROM golang:1.16 AS build
WORKDIR /usr/src/app
COPY code/example-backend/go.mod code/example-backend/go.sum ./
RUN go mod download
COPY code/example-backend .
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o server .
FROM scratch
WORKDIR /usr/src/app
COPY --from=build /usr/src/app/server .
EXPOSE 8080
ENV PORT=8080
ENV REQUEST_ORIGIN=http://localhost:5001
USER 1000:1000
CMD ["./server"]